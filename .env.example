GROQ_API_KEY=                     # free key from console.groq.com, no card
# Groq chat models, tried in order (free tier, checked 2026-10; no Llama since 2026-08-16)
LLM_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
STT_MODEL=whisper-large-v3-turbo  # Groq Whisper, free tier
VISION_MODEL=                     # Groq free tier has no vision model at the moment; leave blank
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b     # offline fallback; best local answers in npm run bench
OLLAMA_VISION_MODEL=              # optional
STT_PROVIDER=groq                 # groq | local
COSTUME_VISION=off                # groq | local | off
TTS_ENGINE=groq                   # groq = natural voice (uses GROQ_API_KEY; accept the Orpheus terms once at console.groq.com) | piper = local voice
GROQ_TTS_VOICE=deepest            # deepest = the server measures troy, daniel and austin at start-up and picks the lowest; or name one
TTS_VOICE=en_GB-alan-medium       # local Piper voice: the backup when Groq fails, or the voice when TTS_ENGINE=piper
VOICE_PITCH=0.7                   # below 1 = deeper at the same speed; 0.7 is very deep; below 0.65 gets muddy; 1 = the plain voice
VOICE_SPEED=1.35                  # above 1 = faster talking at the same pitch (long pauses are always cut); 1 = as the voice speaks
VOICE_ACTING=on                   # on = the Groq voice acts each mood (cheerful, whisper...); off if it ever reads those words aloud
VOICE_ECHO=0.4                    # 0 = dry; 1 = a big echoing hall
VOICE_BASS=0.5                    # a rumble an octave below the voice; 0 = off, 1 = strong
LISTEN_MODE=half-duplex           # half-duplex | barge-in | push-to-talk
VAD_POSITIVE_THRESHOLD=0.5        # raise for a noisier room
VAD_NEGATIVE_THRESHOLD=0.35
VAD_REDEMPTION_MS=700             # silence that ends an utterance; lower = faster, but cuts off slow talkers
WAKE_FACE_MS=800
IDLE_NO_FACE_MS=15000
IDLE_NO_SPEECH_MS=10000
MAX_VISIT_SECONDS=180
PORT=5173
