# Magic Mirror settings. Copy this file to .env and put in your Groq key(s).
# Every other value below is already the built-in default, so you can delete any line you don't
# change: a line in .env always wins, and deleting it lets later improvements to the default reach you.
# .env also wins over the same setting in your system or terminal (the server warns when they differ).
# The server reads .env when it starts: after changing it, stop the server (Ctrl+C) and start it again.
# On start it prints the last 4 characters of each Groq key it loaded, and the D panel shows them too.

# --- Which engine does each job (the local-models branch: everything on this computer) ---
# See LOCAL.md to set up a computer. Each job can go back to Groq on its own (needs GROQ_API_KEY).
AI_ENGINE=local                   # local = Ollama on this computer | groq
STT_ENGINE=local                  # local = Whisper in the browser | groq
TTS_ENGINE=kokoro                 # kokoro = natural local voice | piper = smaller local voice, fast on any processor | groq
LOCAL_DEVICE=auto                 # where the browser runs Kokoro and Whisper: auto (graphics card if there is one) | webgpu | wasm (processor)
KOKORO_VOICE=am_fenrir            # am_fenrir | am_michael | bm_george | am_onyx | am_santa | bm_lewis (press V to hear them)
STT_LOCAL_MODEL=onnx-community/whisper-small   # bigger hears Taglish better but is slower: onnx-community/whisper-large-v3-turbo with a graphics card; onnx-community/whisper-base for a slow computer

# --- Groq: the AI, speech-to-text and the voice ---
# Keys from console.groq.com. Several, comma-separated (key1,key2,key3), are used in turn: one that
# hits "too many requests" rests while the others carry on. GROQ_API_KEY_2=, GROQ_API_KEY_3= also work.
# Groq limits each ORGANIZATION (account), not each key: a new key made in the same account shares the
# same limit. On the free tier the voice gets only 3,600 tokens a day per organization (about 30-40
# replies; checked 2026-10), so use keys from different accounts or a paid plan for a whole party.
# Lines said before are kept in .mirror-cache/ and cost nothing. When every key is used up, the local
# voice speaks instead. The server log names each key's organization when Groq refuses it.
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b   # chat models, tried in order (free tier, checked 2026-10)
STT_MODEL=whisper-large-v3,whisper-large-v3-turbo   # speech-to-text, tried in order; the full large-v3 hears Tagalog better
STT_LANGUAGE=                     # blank = Whisper hears the language (best for Taglish); tl or en forces one

# --- The local AI (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b     # the local AI (download it once: ollama pull llama3.1:8b); gemma3:4b for a slower computer

# --- The voice: fun, deep, with an echo, and clear for small children ---
TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=deepest            # deepest = measured once and remembered in .mirror-memory.json | troy | daniel | austin (press V to hear them)
TTS_VOICE=en_GB-alan-medium       # the local Piper voice: the backup when Groq can't answer, or the voice when TTS_ENGINE=piper
VOICE_PITCH=0.8                   # below 1 = deeper at the same speed; 0.8 is deep and still clear; 0.75 or lower starts to sound robotic
VOICE_SPEED=0.85                  # 1 = the voice's own speed; 0.85 = a little slower, easy for kids to follow; above 1 = faster
VOICE_ACTING=on                   # on = a fun tone that follows the face (cheerful, playful); off = one plain tone
VOICE_ECHO=0.3                    # the magic-glass echo: 0 = none, 0.3 = a clear echo that stays off the words, above 0.5 starts to blur them
VOICE_BASS=0.2                    # a soft rumble an octave below the voice: 0 = off, 0.2 = a touch of depth, above 0.4 sounds robotic

# --- Treats: the mirror tells the children this rule ---
CANDY_RULE=Each child may take ONE treat from the bowl.

# --- The microphone ---
MIC_NEAR_DB=7                     # answer only voices this many dB above the room (the child at the mirror); the D panel shows each ("heard"); lower if it ignores kids, raise if it answers the crowd; 0 = off
VAD_POSITIVE_THRESHOLD=0.5        # how sure the speech detector must be that someone is talking; raise for a noisier room
VAD_NEGATIVE_THRESHOLD=0.35       # below this, talking has stopped
VAD_REDEMPTION_MS=1200            # silence that ends a sentence; children pause to think, so keep it above 1000 ("I'm a..." also waits 3 s more)

# --- The server ---
PORT=5173
